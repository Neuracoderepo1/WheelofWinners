# Server-side Supabase configuration. Copy to .env.local.
# The service-role key must remain server-only and must never use NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Browser-safe Supabase configuration for email OTP sign-in.
# The publishable/anon key is designed for public clients; database access
# remains protected by RLS. Never place the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
